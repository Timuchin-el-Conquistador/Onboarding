{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@org/my-lib": ["/libs/my-lib/src/index.ts"],
      "@org/my-lib/interceptors": ["./libs/my-lib//src/index.ts"],
      "@org/my-lib/types": ["./libs/my-lib//src/index.ts"],
      "@org/my-lib/operators": ["./libs/my-lib//src/index.ts"],
      "@org/my-lib/models": ["./libs/my-lib/src/index.ts"],
      "@org/my-lib/services": ["./libs/my-lib/src/index.ts"],
      "@org/my-lib/tokens": ["./libs/my-lib/src/index.ts"],
      "@org/shared": ["./libs/shared/src/index.ts"],
      "@org/shared/forms": ["./libs/shared/src/index.ts"],
      "@org/shared/operators": ["./libs/shared/src/index.ts"],
      "@org/shared/models": ["./libs/shared/src/index.ts"],
      "@org/shared/environments": ["./libs/shared/src/index.ts"],
      "@org/shared/tokens": ["./libs/shared/src/index.ts"],
      "@org/shared/services": ["./libs/shared/src/index.ts"],
      "@org/shared/interceptors": ["./libs/shared/src/index.ts"],
      "@org/auth": ["./apps/auth/src/app/app.routes.ts"],
      "@org/auth/config": ["./apps/auth/src/app/app.config.ts"],
      "@org/task-manager": ["./apps/task-manager/src/app/app.routes.ts"],
      "@org/task-manager/config": ["./apps/task-manager/src/app/app.config.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
