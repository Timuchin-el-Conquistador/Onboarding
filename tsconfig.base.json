{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@org/my-lib/operators": ["./libs/my-lib//src/index.ts"],
      "@org/my-lib/forms": ["./libs/my-lib/src/index.ts"],
      "@org/my-lib": ["/libs/my-lib/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
